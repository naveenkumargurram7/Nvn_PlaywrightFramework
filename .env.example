# API Testing Framework - Environment Configuration Template
# Copy this file to .env and fill in your values

# ==========================================
# API Configuration
# ==========================================

# Base URL for API endpoints
API_BASE_URL=https://jsonplaceholder.typicode.com

# API Version (if applicable)
API_VERSION=v1

# Request timeout in milliseconds (default: 30000 = 30 seconds)
API_TIMEOUT=30000

# ==========================================
# Authentication
# ==========================================

# Bearer Token for Authorization header
# If your API uses: Authorization: Bearer <token>
BEARER_TOKEN=

# API Key for X-API-Key header
# If your API uses: X-API-Key: <key>
API_KEY=

# ==========================================
# Environment Configuration
# ==========================================

# Current environment (development, staging, production)
ENVIRONMENT=staging

# ==========================================
# Retry Configuration
# ==========================================

# Number of retries for failed requests
RETRY_COUNT=2

# Delay between retries in milliseconds
RETRY_DELAY=1000

# ==========================================
# Application Configuration (Existing)
# ==========================================

# Username for authentication
USERNAME=your_username

# Password for authentication
PASSWORD=your_password

# Base URL for application
BASE_URL=https://ctcorphyd.com/SureshIT/login.php

# ==========================================
# Example Configurations for Different APIs
# ==========================================

# --- JSONPlaceholder (Public Test API) ---
# API_BASE_URL=https://jsonplaceholder.typicode.com
# BEARER_TOKEN=
# API_KEY=

# --- REST Countries API ---
# API_BASE_URL=https://restcountries.com/v3.1
# BEARER_TOKEN=
# API_KEY=

# --- OpenWeather API ---
# API_BASE_URL=https://api.openweathermap.org/data/2.5
# API_KEY=your_openweather_api_key

# --- GitHub API ---
# API_BASE_URL=https://api.github.com
# BEARER_TOKEN=your_github_token

# ==========================================
# Notes
# ==========================================
# 1. Never commit .env file to version control
# 2. Add .env to .gitignore
# 3. Create separate .env files for different environments
# 4. Use environment-specific values for production
# 5. Keep sensitive values secure (tokens, keys, passwords)
